# Build products, wherever they are built.
bin/
obj/
*.o

# Generated by the old compiler's build.
old-acc/src/tccdefs_.h
old-acc/src/c2str

# A pristine tinycc, cloned on demand by old-acc/test/equivalence.sh as the
# reference its comparison runs against.
old-acc/test/ref/

# The compiler's identity, worked out at build time.
src/acc_build.h

# Python's byte-compiled caches, from the test scripts' modules.
__pycache__/

# The conformance suite's imported tests: fetched, never committed.
test/conformance/cache/
# test/size.sh fetches vi here: GPL, never committed.
test/perf/cache/

# mkrelease.sh output.
/acc-*.zip
