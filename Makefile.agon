# Builds acc to run on the Agon itself, with agondev.
#
#   make -f Makefile.agon          # bin/acc.bin
#
# Separate from the host Makefile because this is a different compiler
# producing a different kind of output, and because it needs agondev on the
# path while the host build does not.

AGONDEV ?= $(HOME)/agondev
TOOLS    = $(AGONDEV)/bin
CC       = $(TOOLS)/ez80-none-elf-clang
LD       = $(TOOLS)/ez80-none-elf-ld

BIN  = bin
OBJ  = obj/agon
NAME = acc

# `make -f Makefile.agon CYCLES=1` builds bin/acc-cycles.bin, which also
# prints how many cycles the compile took, counted by one of the eZ80's own
# timers: see cycles_start in parse.c. The compile itself is the same code;
# only main differs. Its objects are kept apart so that neither build is
# linked from the other's.
ifdef CYCLES
OBJ     = obj/agon-cycles
NAME    = acc-cycles
EXTRA   = -DACC_CYCLES
endif

# `make -f Makefile.agon STACK=1` builds bin/acc-stack.bin, which paints the
# room the linker script leaves between the heap's top and the stack, and
# says at the end how much of it the compile used. That is where the size of
# the reserve in src/agon.ld comes from; nothing else needs it.
ifdef STACK
OBJ     = obj/agon-stack
NAME    = acc-stack
EXTRA   = -DACC_STACK
endif

# -inline-threshold=-10 on top: clang still inlines what is called once
# and what says always_inline, and stops inlining small functions it has a
# call to anyway. acc.bin came out 1,391 bytes smaller -- heap, on the Agon
# -- and compiling 0.4% slower; at -40, 238 bytes more for 1.3% more.
#
# -Oz because the budget is space. The Agon gives a program 448 KB for code,
# data, heap and stack together, and every byte acc is not is a byte left for
# the symbol table of whatever it is compiling.
CFLAGS = -mllvm -z80-gas-style -mllvm -z80-print-zero-offset \
         -nostdinc -Isrc -isystem $(AGONDEV)/include \
         -target ez80-none-elf -DAGONDEV \
         -Oz -mllvm -inline-threshold=-10 \
         -Wa,-march=ez80+full -fno-threadsafe-statics $(EXTRA)

# acc takes a command line, and splits it itself: see parse_option in
# parse.c, which is what agondev's crt0 calls to split one.
LDFLAGS = -defsym=RAM_START=0x40000 -defsym=RAM_SIZE=0x70000 \
          -defsym=_has_exit_handler=0 \
          -T src/agon.ld --oformat binary \
          --wrap=_sbrk

SRCS = src/obj.c src/lex.c src/float.c src/sym.c src/gen.c src/out.c src/parse.c \
       src/fmt.c

# The same headers the host build lists. Naming only src/acc.h here left the
# Agon build carrying whatever src/rt_helpers.h said when it was last
# compiled: regenerating the runtime from src/rt/helpers.s changed the blob
# the host build emitted and not the one the Agon build did, and target.sh
# reported eighty-one programs where the two builds disagreed -- which they
# did, about a runtime one of them had not been told about.
HDRS = src/acc.h src/timing.h src/ctype.h src/rt_helpers.h src/version.h src/fmt.h

OBJS = $(patsubst src/%.c,$(OBJ)/%.o,$(SRCS)) $(OBJ)/marks.o

.PHONY: all clean size cflags
all: $(BIN)/$(NAME).bin

$(BIN)/$(NAME).bin: $(OBJS) src/agon.ld | $(BIN)
	@echo [linking $@]
	$(LD) $(LDFLAGS) -Map=$(BIN)/$(NAME).map -o $@ $(OBJS) -L$(AGONDEV)/lib -lagon
	$(TOOLS)/agondev-setname $@ >/dev/null
	@$(MAKE) -s -f Makefile.agon size

# The same rule as the host build's, over the same files, so that the two
# builds of one source agree about what they are. See src/build_id.sh.
src/acc_build.h: $(SRCS) src/acc.h src/rt_helpers.h src/build_id.sh
	@id=$$(src/build_id.sh 2>/dev/null) || id=0; [ -n "$$id" ] || id=0; \
	 printf '/* Generated by src/build_id.sh. Do not edit. */\n#define ACC_BUILD %s\n' \
	     "$$id" > $@.tmp
	@cmp -s $@.tmp $@ || mv $@.tmp $@
	@$(RM) $@.tmp

# The sources as compiled: src/ with the words of every error message
# packed into single bytes, which src/fmt.c expands as it prints -- some
# 20 KB of sentences, and every byte of acc.bin is a byte of the Agon's heap.
# See src/msgpack.py. One run writes them all, so a stamp stands for them.
PP = $(OBJ)/pp

$(PP)/.stamp: $(SRCS) src/msgpack.py | $(OBJ)
	@echo [packing the messages]
	python3 src/msgpack.py $(PP) $(SRCS)
	@touch $@

$(PP)/%.c: $(PP)/.stamp ;

$(OBJ)/%.o: $(PP)/%.c $(HDRS) $(PP)/.stamp | $(OBJ)
	@echo [compiling $<]
	$(CC) $(CFLAGS) -DACC_MSG_PACKED -I$(PP) -c $< -o $@

# The loop lex.c folds every byte it reads through, written by hand for the
# Agon: see the file.
$(OBJ)/marks.o: src/marks.s | $(OBJ)
	@echo [assembling $<]
	$(TOOLS)/ez80-none-elf-as -march=ez80+full $< -o $@

# Only the one file that reads it, so that editing the lexer does not rebuild
# the whole compiler for the Agon.
$(OBJ)/obj.o: src/acc_build.h

size: $(BIN)/$(NAME).bin
	@echo "[$$(stat -c%s $(BIN)/$(NAME).bin) bytes of image, of 458752 available]"
	@$(TOOLS)/ez80-none-elf-size $(OBJS) | tail -n +2 \
	  | awk '{t+=$$1; d+=$$2; b+=$$3} END {printf "[text %d  data %d  bss %d  = %d, leaving %d for heap and stack]\n", t, d, b, t+d+b, 458752-(t+d+b)}'

# The flags, for the tests that read the assembly they make: test/frames.sh
# and test/budget.sh.
cflags:
	@echo $(CFLAGS)

$(BIN) $(OBJ):
	@mkdir -p $@

clean:
	$(RM) -r $(OBJ) $(BIN)/$(NAME).bin $(BIN)/$(NAME).map
	$(RM) src/acc_build.h
